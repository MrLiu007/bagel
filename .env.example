# =========================
# Application
# =========================

APP_ENV=production
APP_HOST=0.0.0.0
# 本机 `bagel dev` 监听端口。Docker Compose 容器内固定 8000，宿主机映射见下方 BAGEL_*。
APP_PORT=8000
LOG_LEVEL=INFO

# Docker Compose 宿主机映射（多容器 ECS 推荐默认：仅本机 6280，由 Nginx 反代 /bagel/）
# BAGEL_BIND=127.0.0.1
# BAGEL_HOST_PORT=6280
# 本机想直接浏览器访问 Compose：BAGEL_BIND=0.0.0.0  BAGEL_HOST_PORT=8000

# =========================
# Storage (open-source default = sqlite)
# sqlite | postgres
# Wiki 是 Markdown 导出层，不能替代事务库；需要无服务组件请用 sqlite。
# =========================

STORAGE_BACKEND=sqlite
DATABASE_URL=sqlite+pysqlite:///./data/bagel.db

# Postgres 示例（与 compose.yml 默认账号一致）：
# STORAGE_BACKEND=postgres
# DATABASE_URL=postgresql+psycopg://bagel:bagel@127.0.0.1:5432/bagel

WIKI_ENABLED=false
WIKI_DIR=data/wiki
# Wiki 正文在 Markdown；wiki_page / wiki_edge 在事务库中做索引与边查询。
# 领域 taxonomy 结构在包内 seed（非 Marble 课标数据），供 GBrain 统一投影。

# =========================
# GitHub
# =========================

# GitHub PAT — 学习页 / 采集强烈建议配置；匿名仅约 60 次/小时，易触发 403 rate limit
# 经典 Token：https://github.com/settings/tokens （勾选 public_repo 即可）
GITHUB_TOKEN=

# Semantic Scholar API (optional; without key, LLM search may hit 429)
SEMANTIC_SCHOLAR_API_KEY=

# =========================
# LLM (OpenAI-compatible)
# =========================

LLM_ENABLED=true
# openai | azure | deepseek | moonshot | volcengine | custom
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_API_KEY=
# 火山引擎方舟请填【推理接入点 ID】，不是模型展示名
LLM_MODEL=
LLM_TIMEOUT_SECONDS=180

# =========================
# Auth
# =========================

SESSION_SECRET=bagel-change-me-in-production
AUTH_REQUIRED=true

# =========================
# Internal Services (optional, invisible to end users)
# =========================

RSSHUB_BASE_URL=http://127.0.0.1:1200
FRESHRSS_BASE_URL=http://127.0.0.1:8080

# =========================
# Network
# =========================

NETWORK_MODE=AUTO

HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1,postgres,rsshub,freshrss

# =========================
# Schedule (optional; UI defaults to manual collect)
# =========================

NEWS_COLLECT_INTERVAL_MINUTES=30
GITHUB_COLLECT_INTERVAL_MINUTES=60
DIGEST_HOUR=18

# =========================
# Features
# =========================

ENABLE_GITHUB=true
ENABLE_OVERSEAS_SOURCES=true
ENABLE_LLM_SUMMARY=true

# Scheduler (UI can override → data/runtime_config.json)
ENABLE_SCHEDULER=false
# NEWS_COLLECT_INTERVAL_MINUTES still used as seed default; UI uses fixed options 30/60/120/240/480/720
SCHEDULER_JITTER_SECONDS=120

# Feishu / Lark CLI (UI overrides in runtime_config.json)
ENABLE_FEISHU_CLI=false
FEISHU_CLI_BIN=lark-cli
FEISHU_WEBHOOK_URL=
# 场景1：企业自建应用（事件订阅 → POST /api/feishu/events）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
# 可留空：后台关闭「加密策略」即可
FEISHU_ENCRYPT_KEY=

# Stock Phase 2
ENABLE_STOCK_ENRICHMENT=true
ENABLE_STOCK_MARKET_DATA=true
ENABLE_STOCK_RESEARCH_DRAFT=true
STOCK_MARKET_LOOKBACK_DAYS=14

# Only ingest items published within this many days
COLLECT_LOOKBACK_DAYS=14
# News crawl pacing (sequential sources — no thread pool)
NEWS_SOURCE_SLEEP_SEC=1.5
NEWS_REDDIT_SLEEP_SEC=8
NEWS_RATE_LIMIT_COOLDOWN_SEC=18
NEWS_SOURCE_MAX_ATTEMPTS=2

# =========================
# MediaCrawler（自媒体；本机克隆，勿 vendoring / 勿 git 提交）
# 启动时默认自动 git clone（缺失才拉）；GitHub 可能需 VPN 或镜像
# 详见 docs/git-and-mediacrawler.md · third_party/README.md
# =========================

ENABLE_MEDIA_CRAWLER=true
MEDIA_CRAWLER_AUTO_SETUP=true
MEDIA_CRAWLER_PATH=./third_party/MediaCrawler
# 留空 = 官方 GitHub；网络不稳时填镜像 URL
MEDIA_CRAWLER_GIT_URL=
MEDIA_CRAWLER_GIT_REF=main
MEDIA_CRAWLER_CMD=uv run main.py
MEDIA_CRAWLER_PLATFORMS=xhs
MEDIA_CRAWLER_KEYWORDS=AI 教育
MEDIA_CRAWLER_LOGIN_TYPE=qrcode
# Keep low for account safety (notes per platform / crawl)
MEDIA_CRAWLER_MAX_NOTES=8
MEDIA_CRAWLER_SLEEP_SEC=6
MEDIA_CRAWLER_MAX_KEYWORDS=2
# false=自动启动浏览器（推荐）；true=连接已开启远程调试的 Chrome :9222
MEDIA_CRAWLER_CDP_CONNECT_EXISTING=false
# false=Playwright 标准模式（推荐，二维码更稳定）；true=CDP 控制本机 Chrome
MEDIA_CRAWLER_ENABLE_CDP_MODE=false
# 富媒体可选（默认关）：评论 / 子评论 / MediaCrawler 本地下载媒体
# 视频学习与字幕请用 /av + yt-dlp；勿默认打开 GET_MEDIAS
MEDIA_CRAWLER_GET_COMMENTS=false
MEDIA_CRAWLER_GET_SUB_COMMENTS=false
MEDIA_CRAWLER_GET_MEDIAS=false
# 勿把 PLAYWRIGHT_BROWSERS_PATH 指到 Cursor 沙箱空目录，否则浏览器不会弹窗。
# 首次需在 MediaCrawler 目录执行：.venv\Scripts\python.exe -m playwright install chromium

# =========================
# yt-dlp（学习音视频；本机克隆，勿 vendoring / 勿 git 提交）
# 详见 docs/git-and-ytdlp.md · third_party/README.md
# =========================

ENABLE_YTDLP=true
YTDLP_AUTO_SETUP=true
YTDLP_PATH=./third_party/yt-dlp
YTDLP_GIT_URL=
YTDLP_GIT_REF=2026.08.19
AV_MAX_ITEMS_PER_SOURCE=30
AV_DOWNLOAD_DIR=data/av/files
AV_DEFAULT_AUDIO_ONLY=false
AV_MAX_HEIGHT=720
AV_MAX_FILE_SIZE_MB=2048
AV_WRITE_SUBTITLES=true
AV_SUBTITLE_LANGS=zh,en
AV_COOKIES_FILE=
# Prefer Edge: Chrome often locks Cookies; Bilibili/Douyin need browser cookies.
# Douyin: open douyin.com in that browser first, then close it before download.
AV_COOKIES_FROM_BROWSER=edge
AV_BILIBILI_BROWSER=edge,chrome
FFMPEG_PATH=
# 无平台 CC / 烧录字幕时：对本地音轨 ASR
AV_ASR_ENABLED=true
# auto | volcengine | openai | faster_whisper | off（auto 优先火山）
AV_ASR_BACKEND=auto
AV_ASR_MODEL=whisper-1
AV_ASR_LANGUAGE=zh
# 作者简介≠画面字幕；默认关闭
AV_FALLBACK_AUTHOR_DESC=false
# 火山引擎 openspeech / 豆包语音 录音文件识别
# https://openspeech.bytedance.com/api/v3/auc/bigmodel/...
# 新版控制台：只填 API Key；旧版：填 APP ID + Access Token
VOLC_ASR_API_KEY=
VOLC_ASR_APP_ID=
VOLC_ASR_ACCESS_KEY=
VOLC_ASR_RESOURCE_ID=volc.seedasr.auc
VOLC_ASR_FLASH_RESOURCE_ID=volc.bigasr.auc_turbo
# auto=短音频极速版，长音频走 submit/query；也可强制 async / flash
VOLC_ASR_MODE=auto
VOLC_ASR_POLL_INTERVAL_SEC=2
VOLC_ASR_POLL_TIMEOUT_SEC=900
VOLC_ASR_HTTP_TIMEOUT_SEC=120
VOLC_ASR_MAX_RETRIES=3
VOLC_ASR_MAX_FILE_MB=200
VOLC_ASR_FLASH_MAX_MB=8
# 自媒体/音视频周月报：生成前用 yt-dlp 提取字幕写入正文（默认开）
BRIEF_AUTO_ENRICH_MEDIA=true
BRIEF_ENRICH_MAX_ITEMS=8

# =========================
# 论文 PDF + 文档识别（MinerU Cloud / Kimi 文件抽取，负载+故障转移）
# MinerU: https://mineru.net/apiManage/docs
# Kimi:   https://platform.kimi.com/docs/api/files-upload
# =========================

ENABLE_PAPER_PARSE=true
PAPER_PARSE_PROVIDERS=mineru,kimi
PAPER_PARSE_STRATEGY=round_robin
PAPER_PARSE_TIMEOUT_SEC=300
ENABLE_MINERU=true
MINERU_API_TOKEN=
MINERU_MODEL_VERSION=vlm
ENABLE_KIMI_FILES=true
KIMI_API_KEY=
KIMI_FILES_BASE_URL=
UNPAYWALL_EMAIL=bagel@localhost

# =========================
# Archify + GitHub 学习（Qoder Wiki 风格）
# 详见 docs/github-learn.md · docs/archify-and-github-briefs.md
# =========================

ENABLE_ARCHIFY=true
ARCHIFY_AUTO_SETUP=true
ARCHIFY_PATH=./third_party/archify
ARCHIFY_GIT_URL=
ARCHIFY_GIT_REF=main
ENABLE_GITHUB_LEARN=true
GITHUB_LEARN_MAX_FILES=80
GITHUB_LEARN_MAX_SNIPPETS=24
GITHUB_LEARN_SNIPPET_CHARS=4000

# =========================
# Gewe 微信
# 详见 docs/user-config-media-wechat.md
# =========================

ENABLE_WECHAT=false
GEWE_BASE_URL=http://api.geweapi.com/gewe/v2/api
GEWE_TOKEN=
GEWE_APP_ID=
GEWE_CALLBACK_URL=http://127.0.0.1:8000/api/wechat/webhook
GEWE_KEYWORDS=大模型,AI,Agent
