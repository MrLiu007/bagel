# =========================
# Application
# =========================

APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# =========================
# Storage (open-source default = sqlite)
# sqlite | postgres
# Wiki 是 Markdown 导出层，不能替代事务库；需要无服务组件请用 sqlite。
# =========================

STORAGE_BACKEND=sqlite
DATABASE_URL=sqlite+pysqlite:///./data/bagel.db

# Postgres 示例（与 compose.yml 默认账号一致）：
# STORAGE_BACKEND=postgres
# DATABASE_URL=postgresql+psycopg://bagel:bagel@127.0.0.1:5432/bagel

WIKI_ENABLED=false
WIKI_DIR=data/wiki

# =========================
# GitHub
# =========================

GITHUB_TOKEN=

# =========================
# LLM (OpenAI-compatible)
# =========================

LLM_ENABLED=true
# openai | azure | deepseek | moonshot | volcengine | custom
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_API_KEY=
# 火山引擎方舟请填【推理接入点 ID】，不是模型展示名
LLM_MODEL=
LLM_TIMEOUT_SECONDS=180

# =========================
# Auth
# =========================

SESSION_SECRET=bagel-change-me-in-production
AUTH_REQUIRED=true

# =========================
# Internal Services (optional, invisible to end users)
# =========================

RSSHUB_BASE_URL=http://127.0.0.1:1200
FRESHRSS_BASE_URL=http://127.0.0.1:8080

# =========================
# Network
# =========================

NETWORK_MODE=AUTO

HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1,postgres,rsshub,freshrss

# =========================
# Schedule (optional; UI defaults to manual collect)
# =========================

NEWS_COLLECT_INTERVAL_MINUTES=30
GITHUB_COLLECT_INTERVAL_MINUTES=60
DIGEST_HOUR=18

# =========================
# Features
# =========================

ENABLE_GITHUB=true
ENABLE_OVERSEAS_SOURCES=true
ENABLE_LLM_SUMMARY=true

# Scheduler (UI can override → data/runtime_config.json)
ENABLE_SCHEDULER=false
# NEWS_COLLECT_INTERVAL_MINUTES still used as seed default; UI uses fixed options 30/60/120/240/480/720
SCHEDULER_JITTER_SECONDS=120

# Feishu / Lark CLI (UI overrides in runtime_config.json)
ENABLE_FEISHU_CLI=false
FEISHU_CLI_BIN=lark-cli
FEISHU_WEBHOOK_URL=
# 场景1：企业自建应用（事件订阅 → POST /api/feishu/events）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
# 可留空：后台关闭「加密策略」即可
FEISHU_ENCRYPT_KEY=

# Stock Phase 2
ENABLE_STOCK_ENRICHMENT=true
ENABLE_STOCK_MARKET_DATA=true
ENABLE_STOCK_RESEARCH_DRAFT=true
STOCK_MARKET_LOOKBACK_DAYS=14

# Only ingest items published within this many days
COLLECT_LOOKBACK_DAYS=14

# =========================
# MediaCrawler（自媒体；本机克隆，勿 vendoring / 勿 git 提交）
# 启动时默认自动 git clone（缺失才拉）；GitHub 可能需 VPN 或镜像
# 详见 docs/git-and-mediacrawler.md · third_party/README.md
# =========================

ENABLE_MEDIA_CRAWLER=true
MEDIA_CRAWLER_AUTO_SETUP=true
MEDIA_CRAWLER_PATH=./third_party/MediaCrawler
# 留空 = 官方 GitHub；网络不稳时填镜像 URL
MEDIA_CRAWLER_GIT_URL=
MEDIA_CRAWLER_GIT_REF=main
MEDIA_CRAWLER_CMD=uv run main.py
MEDIA_CRAWLER_PLATFORMS=xhs
MEDIA_CRAWLER_KEYWORDS=AI 教育
MEDIA_CRAWLER_LOGIN_TYPE=qrcode
# Keep low for account safety (notes per platform / crawl)
MEDIA_CRAWLER_MAX_NOTES=8
MEDIA_CRAWLER_SLEEP_SEC=6
MEDIA_CRAWLER_MAX_KEYWORDS=2
# false=自动启动浏览器（推荐）；true=连接已开启远程调试的 Chrome :9222
MEDIA_CRAWLER_CDP_CONNECT_EXISTING=false
# false=Playwright 标准模式（推荐，二维码更稳定）；true=CDP 控制本机 Chrome
MEDIA_CRAWLER_ENABLE_CDP_MODE=false
# 勿把 PLAYWRIGHT_BROWSERS_PATH 指到 Cursor 沙箱空目录，否则浏览器不会弹窗。
# 首次需在 MediaCrawler 目录执行：.venv\Scripts\python.exe -m playwright install chromium

# =========================
# Gewe 微信
# 详见 docs/user-config-media-wechat.md
# =========================

ENABLE_WECHAT=false
GEWE_BASE_URL=http://api.geweapi.com/gewe/v2/api
GEWE_TOKEN=
GEWE_APP_ID=
GEWE_CALLBACK_URL=http://127.0.0.1:8000/api/wechat/webhook
GEWE_KEYWORDS=大模型,AI,Agent
